{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --parallel --filter @takaran/app --filter @takaran/web preview",
      "startServerReadyPattern": "Local:|localhost",
      "url": [
        "http://127.0.0.1:5173/",
        "http://127.0.0.1:4321/"
      ],
      "numberOfRuns": 3,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
