{
  "name": "takaran",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @takaran/site dev",
    "test": "vitest run",
    "test:calc:coverage": "vitest run --coverage",
    "test:calc:bench": "vitest bench packages/calc/bench/recalc.bench.ts",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "biome check .",
    "build": "pnpm --recursive --if-present build",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@vitest/coverage-v8": "5.0.1",
    "fast-check": "^4.10.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
