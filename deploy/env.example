# Salin ke .env di server (cp deploy/env.example .env), lalu isi semuanya.
# File .env tidak boleh di-commit. Batasi aksesnya: chmod 600 .env

# Domain tanpa https:// (DNS harus sudah mengarah ke server ini)
DOMAIN=takaran.contoh.id

# Google Analytics 4 Measurement ID untuk halaman publik
NEXT_PUBLIC_GA_ID=G-ZHKNX419F4

# Password database. Buat: openssl rand -base64 24
POSTGRES_PASSWORD=

# Rahasia sesi login (minimal 32 karakter). Buat: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Garam untuk menyamarkan alamat IP pada pembatasan percobaan. Buat: openssl rand -base64 24
IP_SALT=

# Login Google: https://console.cloud.google.com > APIs & Services > Credentials
# Redirect URI yang didaftarkan: https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email yang boleh membuka /admin (Google yang sama saat login), pisahkan dengan koma
ADMIN_EMAILS=

# Mayar. Kosongkan MAYAR_API_KEY bila pembayaran belum dibuka.
# Sandbox: https://api.mayar.io/hl/v2   Produksi: https://api.mayar.id/hl/v2
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.io/hl/v2
# Token acak panjang untuk URL webhook. Buat: openssl rand -hex 24
MAYAR_WEBHOOK_TOKEN=

# Wajib: buat dengan `openssl rand -hex 32`, lalu simpan hanya di password manager.
# Tanpa nilai ini, Docker Compose menolak menjalankan layanan backup.
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14
