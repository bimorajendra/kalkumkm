# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Lokal tanpa Postgres: pglite:./.data/dev  |  Server: postgres://user:pass@host:5432/takaran
DATABASE_URL=pglite:./.data/dev

# Alamat publik aplikasi (tanpa garis miring di akhir)
APP_URL=http://localhost:3000

# String acak minimal 32 karakter: openssl rand -base64 32
BETTER_AUTH_SECRET=
IP_SALT=

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web)
# Redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email admin, pisahkan dengan koma
ADMIN_EMAILS=

# Mayar (kosongkan bila belum dipakai). Sandbox: https://api.mayar.io/hl/v2
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.io/hl/v2
MAYAR_WEBHOOK_TOKEN=
